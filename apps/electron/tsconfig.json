{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib/types",
    "types": ["node"],
    // The preload runs in the renderer and reaches the DOM (window-chrome.ts);
    // the main process also compiles here, and the extra browser globals are
    // harmless to it.
    "lib": ["ES2024", "DOM", "DOM.Iterable"]
  },
  "include": ["src"],
  "references": []
}
