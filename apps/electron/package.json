    "start": "node scripts/electron.mjs .",
    "dev": "pnpm run build && node scripts/electron.mjs ."
  },
  "dependencies": {
    "@deepseek-ai/dsh": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "43.4.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
