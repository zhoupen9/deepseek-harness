{
  "name": "@deepseek-ai/dsh-electron",
  "description": "Electron desktop shell that boots the DeepSeek Harness Web profile (dsh web) in a native window",
  "version": "0.1.2-alpha.1",
  "private": true,
  "type": "module",
  "main": "lib/main.js",
  "license": "MIT",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b",
